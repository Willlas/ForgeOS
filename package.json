{
  "name": "@aer/runtime",
  "version": "0.1.0",
  "description": "Autonomous Engineering Runtime - A provider-independent, modular runtime for autonomous software engineering",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aer": "./dist/cli/index.js",
    "aer-daemon": "./dist/runtime/daemon-entry.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "autonomous",
    "engineering",
    "runtime",
    "multi-agent",
    "scheduler",
    "provider",
    "workflow"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jsonschema": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@vitest/coverage-v8": "^3.0.9",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}