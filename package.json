{
  "name": "@aer/root",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Engineering Runtime - A provider-independent, modular runtime for autonomous software engineering",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "format": "prettier --check packages/",
    "format:fix": "prettier --write packages/",
    "clean": "tsc --build --clean",
    "prepublishOnly": "npm run build",
    "smoke:cli": "node scripts/cli-smoke-test.js",
    "verify:smoke": "node scripts/smoke-test-verify.js"
  },
  "keywords": [
    "autonomous",
    "engineering",
    "runtime",
    "multi-agent",
    "scheduler",
    "provider",
    "workflow"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jsonschema": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitest/coverage-v8": "^3.0.9",
    "dotenv": "^17.4.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
